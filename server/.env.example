# Harmonix server environment (names only — fill values locally; never commit secrets)

PORT=3001

# Auth (required)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional cookie hardening behind HTTPS (Coolify Traefik / production)
# FORCE_SECURE_COOKIES=true
# PUBLIC_BASE_URL=https://harmonix.peeporunclub.co.uk

# AI providers (daily word + vocab). At least one path must work.
# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
# OPENAI_API_KEY=   # alias some setups use for NIM
# OpenRouter fallback
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
# OPENROUTER_TIMEOUT_MS=12000
# NIM_FAST_TIMEOUT_MS=8000
# VALIDATE_CONCURRENCY=5
# NVIDIA_NIM_MODELS=meta/llama-3.1-8b-instruct,minimaxai/minimax-m3,qwen/qwen3-next-80b-a3b-instruct
# Bench: node scripts/benchmark-free-models.js

# Spotify OAuth (Phase 12+) — Client ID from Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
# Production example: https://harmonix.peeporunclub.co.uk/callback
SPOTIFY_WEB_SUCCESS_URL=
SPOTIFY_WEB_ERROR_URL=
SPOTIFY_ANDROID_SUCCESS_URL=
SPOTIFY_ANDROID_ERROR_URL=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_TOKEN_ENCRYPTION_KEY_VERSION=v1
SPOTIFY_TOKEN_KEY_CUSTODY_OWNER=local-dev-server-env
SPOTIFY_MATCH_CACHE_POLICY=ttl=7d;revalidate_on_export;delete_on_disconnect
# Includes streaming + playback-control scopes for Web Playback SDK (Premium). Users must reconnect after changing scopes.
SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative playlist-modify-private streaming user-read-email user-read-private user-modify-playback-state user-read-playback-state
SPOTIFY_QUOTA_MODE=development

# Pocket-TTS (pronunciation). Defaults to local install paths on the VPS.
# POCKET_TTS_BIN=
# TTS_PORT=3002
