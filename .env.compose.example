# .env.compose.example — copy to `.env` beside docker-compose.yml (gitignored)
# Or rely on `server/.env` via compose `env_file` (preferred on the VPS).
# Coolify: paste these in the resource Environment UI instead.

JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-xxxxxxxxxxxx

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://harmonix.peeporunclub.co.uk/callback
SPOTIFY_WEB_SUCCESS_URL=https://harmonix.peeporunclub.co.uk/playlists?spotify=connected
SPOTIFY_WEB_ERROR_URL=https://harmonix.peeporunclub.co.uk/settings?spotify=error
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_QUOTA_MODE=development

PUBLIC_BASE_URL=https://harmonix.peeporunclub.co.uk
NEXT_PUBLIC_API_URL=/api
FORCE_SECURE_COOKIES=true
TTS_SKIP_SPAWN=true
# Host TTS reachable from containers (VPS LAN IP; adjust if needed)
TTS_BASE_URL=http://10.0.0.15:3002
HARMONIX_API_PORT=3001
VALIDATE_CONCURRENCY=4
